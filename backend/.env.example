# Copy to .env and replace both placeholders before starting.
APP_NAME=校园在线学习平台
DEBUG=false
DATABASE_URL=mysql+pymysql://campus_app:REPLACE_WITH_DB_PASSWORD@127.0.0.1:3309/campus_learning?charset=utf8mb4
# Generate a random secret, e.g. secrets.token_urlsafe(48).
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
STORAGE_BACKEND=local
CORS_ORIGINS=["http://127.0.0.1:20081","http://localhost:20081"]
